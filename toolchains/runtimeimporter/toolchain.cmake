include_guard(GLOBAL)

# Host-side build tool, independent of the Windows compiler toolchain.
set(RUNTIMEIMPORTER_CONFIG "${CMAKE_CURRENT_LIST_DIR}/toolchain.json" CACHE FILEPATH
    "Runtime-Importer release selection (empty object selects latest)")
set(RUNTIMEIMPORTER_CACHE "${CMAKE_BINARY_DIR}/_tools/runtimeimporter" CACHE PATH
    "Runtime-Importer download cache")

function(_runtimeimporter_download url destination)
    file(DOWNLOAD "${url}" "${destination}" TLS_VERIFY ON
        HTTPHEADER "Accept: application/vnd.github+json"
        HTTPHEADER "User-Agent: Orion.Loader-CMake"
        TIMEOUT 120 STATUS result)
    list(GET result 0 code)
    if(NOT code EQUAL 0)
        file(REMOVE "${destination}")
        message(FATAL_ERROR "Runtime-Importer download failed (${url}): ${result}")
    endif()
endfunction()

function(_runtimeimporter_resolve)
    set(tag "")
    set(pinned_hash "")
    if(EXISTS "${RUNTIMEIMPORTER_CONFIG}")
        file(READ "${RUNTIMEIMPORTER_CONFIG}" config)
        string(JSON type ERROR_VARIABLE error TYPE "${config}")
        if(error OR NOT type STREQUAL "OBJECT")
            message(FATAL_ERROR "Runtime-Importer toolchain.json must be a JSON object: ${error}")
        endif()
        foreach(key IN ITEMS tag sha256)
            string(JSON value ERROR_VARIABLE error GET "${config}" "${key}")
            if(NOT error)
                string(JSON type TYPE "${config}" "${key}")
                if(NOT type STREQUAL "STRING")
                    message(FATAL_ERROR "Runtime-Importer '${key}' must be a string.")
                endif()
                if(key STREQUAL "tag")
                    set(tag "${value}")
                else()
                    set(pinned_hash "${value}")
                endif()
            endif()
        endforeach()
    endif()
    if(tag AND NOT tag MATCHES "^[A-Za-z0-9][A-Za-z0-9._-]*$")
        message(FATAL_ERROR "Invalid Runtime-Importer release tag: ${tag}")
    endif()
    if(pinned_hash AND NOT tag)
        message(FATAL_ERROR "Pin a Runtime-Importer tag when specifying sha256.")
    endif()
    if(tag)
        set(endpoint "tags/${tag}")
        set(metadata_name "${tag}")
    else()
        set(endpoint "latest")
        set(metadata_name "latest")
    endif()
    file(MAKE_DIRECTORY "${RUNTIMEIMPORTER_CACHE}")
    file(LOCK "${RUNTIMEIMPORTER_CACHE}/download.lock" GUARD FUNCTION TIMEOUT 120)
    set(metadata "${RUNTIMEIMPORTER_CACHE}/${metadata_name}.json")
    # Pinned metadata can be reused offline. Latest is resolved each configure.
    if(NOT tag OR NOT EXISTS "${metadata}")
        _runtimeimporter_download("https://api.github.com/repos/AmethystAPI/Runtime-Importer/releases/${endpoint}" "${metadata}.tmp")
        file(RENAME "${metadata}.tmp" "${metadata}")
    endif()
    file(READ "${metadata}" release)
    string(JSON resolved_tag GET "${release}" tag_name)
    if(NOT resolved_tag MATCHES "^[A-Za-z0-9][A-Za-z0-9._-]*$")
        message(FATAL_ERROR "Invalid Runtime-Importer release tag: ${resolved_tag}")
    endif()
    if(tag AND NOT tag STREQUAL resolved_tag)
        message(FATAL_ERROR "Runtime-Importer release does not match the pinned tag.")
    endif()
    string(JSON count LENGTH "${release}" assets)
    set(url "")
    if(count GREATER 0)
        math(EXPR last "${count} - 1")
        foreach(index RANGE 0 ${last})
            string(JSON name GET "${release}" assets ${index} name)
            if(name STREQUAL "Runtime-Importer.zip")
                string(JSON url GET "${release}" assets ${index} browser_download_url)
                string(JSON digest ERROR_VARIABLE error GET "${release}" assets ${index} digest)
                break()
            endif()
        endforeach()
    endif()
    if(NOT url)
        message(FATAL_ERROR "Runtime-Importer ${resolved_tag} has no Runtime-Importer.zip asset.")
    endif()
    if(pinned_hash)
        set(hash "${pinned_hash}")
    elseif(digest MATCHES "^sha256:([a-fA-F0-9]+)$")
        set(hash "${CMAKE_MATCH_1}")
    else()
        message(FATAL_ERROR "Release has no SHA-256 digest; pin tag and sha256 in toolchain.json.")
    endif()
    string(LENGTH "${hash}" length)
    if(NOT length EQUAL 64 OR NOT hash MATCHES "^[a-fA-F0-9]+$")
        message(FATAL_ERROR "Invalid Runtime-Importer SHA-256 digest.")
    endif()
    string(TOLOWER "${hash}" hash)
    set(directory "${RUNTIMEIMPORTER_CACHE}/${resolved_tag}")
    set(archive "${RUNTIMEIMPORTER_CACHE}/${resolved_tag}.zip")
    set(verified "")
    if(EXISTS "${directory}/.complete")
        file(READ "${directory}/.complete" verified)
    endif()
    if(NOT verified STREQUAL "${resolved_tag}\n${hash}\n" OR NOT EXISTS "${directory}/Amethyst.ModuleTweaker.dll")
        set(actual "")
        if(EXISTS "${archive}")
            file(SHA256 "${archive}" actual)
        endif()
        if(NOT actual STREQUAL hash)
            _runtimeimporter_download("${url}" "${archive}.tmp")
            file(SHA256 "${archive}.tmp" actual)
            if(NOT actual STREQUAL hash)
                file(REMOVE "${archive}.tmp")
                message(FATAL_ERROR "Runtime-Importer archive SHA-256 mismatch.")
            endif()
            file(RENAME "${archive}.tmp" "${archive}")
        endif()
        file(REMOVE_RECURSE "${directory}.tmp")
        file(MAKE_DIRECTORY "${directory}.tmp")
        file(ARCHIVE_EXTRACT INPUT "${archive}" DESTINATION "${directory}.tmp")
        if(NOT EXISTS "${directory}.tmp/Amethyst.ModuleTweaker.dll")
            message(FATAL_ERROR "Runtime-Importer archive is missing Amethyst.ModuleTweaker.dll.")
        endif()
        file(WRITE "${directory}.tmp/.complete" "${resolved_tag}\n${hash}\n")
        file(REMOVE_RECURSE "${directory}")
        file(RENAME "${directory}.tmp" "${directory}")
    endif()
    set(RUNTIMEIMPORTER_TAG "${resolved_tag}" PARENT_SCOPE)
    set(RUNTIMEIMPORTER_DIR "${directory}" PARENT_SCOPE)
    set(RUNTIMEIMPORTER_DLL "${directory}/Amethyst.ModuleTweaker.dll" PARENT_SCOPE)
    message(STATUS "Runtime-Importer: ${resolved_tag}")
endfunction()

_runtimeimporter_resolve()
# Editing the selection also triggers reconfiguration on the next build.
if(EXISTS "${RUNTIMEIMPORTER_CONFIG}" AND NOT CMAKE_SCRIPT_MODE_FILE)
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${RUNTIMEIMPORTER_CONFIG}")
endif()
